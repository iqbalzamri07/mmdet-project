{
  "model": {
    "num_keypoints": 17,
    "keypoint_dims": 2,
    "hidden_dim": 256,
    "num_heads": 8,
    "num_layers": 6,
    "dropout": 0.1,
    "max_seq_len": 128
  },
  "training": {
    "batch_size": 16,
    "num_epochs": 100,
    "learning_rate": 0.0001,
    "weight_decay": 0.00001,
    "warmup_epochs": 10,
    "gradient_clip": 1.0
  },
  "data": {
    "sequence_length": 64,
    "stride": 8,
    "num_classes": 6,
    "class_names": [
      "smoking",
      "sitting", 
      "standing",
      "walking",
      "calling",
      "playing_phone"
    ],
    "data_dir": "data/pose_sequences",
    "raw_video_dir": "data/custom_actions_videos"
  },
  "augmentation": {
    "enabled": true,
    "noise_std": 0.02,
    "temporal_jitter": 3,
    "scale_range": [0.9, 1.1]
  },
  "paths": {
    "checkpoint_dir": "checkpoints/pose_classifier",
    "log_dir": "logs/pose_classifier", 
    "output_dir": "outputs/pose_classifier"
  },
  "system": {
    "device": "cuda",
    "num_workers": 4,
    "seed": 42
  }
}